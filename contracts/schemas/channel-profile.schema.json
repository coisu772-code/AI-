{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coisu772-code/AI-/contracts/schemas/channel-profile.schema.json",
  "title": "Channel Profile v1",
  "allOf": [
    {
      "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/envelope"
    }
  ],
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "channelProfileId",
    "displayName",
    "lifecycleStatus",
    "targetRegion",
    "outputLanguage",
    "publisherBinding"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractType": { "const": "channel-profile" },
    "channelProfileId": { "type": "string", "minLength": 3, "maxLength": 128 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
    "lifecycleStatus": {
      "type": "string",
      "enum": [
        "PUBLISHER_REQUIRED",
        "PUBLISHER_CHANNEL_AVAILABLE",
        "CHANNEL_BOUND",
        "LIBRARY_DEFAULTS_PENDING",
        "LIBRARY_CREATING",
        "READY",
        "AUTH_NEEDS_ATTENTION",
        "COMPONENT_NEEDS_ATTENTION",
        "LIBRARY_NEEDS_REPAIR",
        "MIGRATION_REQUIRED",
        "ARCHIVED"
      ]
    },
    "targetRegion": { "type": "string", "minLength": 2, "maxLength": 80 },
    "outputLanguage": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$" },
    "publisherBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisherProfileId", "channelSerial", "youtubeChannelId"],
      "properties": {
        "publisherProfileId": { "type": "string", "minLength": 3, "maxLength": 128 },
        "channelSerial": { "type": "string", "pattern": "^[0-9]{2,}$" },
        "youtubeChannelId": { "type": "string", "minLength": 8, "maxLength": 64 }
      }
    }
  }
}

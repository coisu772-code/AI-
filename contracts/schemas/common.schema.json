{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json",
  "title": "AI Video Channel Production Common Contract Definitions",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "bcp47Language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-[A-Z]{2}|-[0-9]{3})?$"
    },
    "contractReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetContractType",
        "targetId",
        "targetVersion",
        "targetSchemaVersion",
        "targetHash"
      ],
      "properties": {
        "targetContractType": {
          "type": "string",
          "enum": [
            "channel-profile",
            "production-profile",
            "source-package",
            "topic-package",
            "manuscript-package",
            "publishing-asset-package",
            "production-result-package",
            "publish-intent",
            "publication-receipt",
            "analytics-snapshot",
            "analysis-package-v1",
            "reference-channel-profile-v1",
            "channel-runtime-profile-v1",
            "account-decomposition-requirements-v1",
            "account-imitation-requirements-v1",
            "account-runtime-validation-v1",
            "video-deconstruction-analysis-v1",
            "writing-style-contract-v1"
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "targetVersion": {
          "$ref": "#/$defs/semver"
        },
        "targetSchemaVersion": {
          "$ref": "#/$defs/semver"
        },
        "targetHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "relativePath",
        "mediaType",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePackage",
        "locator"
      ],
      "properties": {
        "sourcePackage": {
          "allOf": [
            {
              "$ref": "#/$defs/contractReference"
            },
            {
              "properties": {
                "targetContractType": {
                  "const": "source-package"
                }
              }
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "assetId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "excerptHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidenceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "classification",
        "statement",
        "sources"
      ],
      "properties": {
        "claimId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "classification": {
          "type": "string",
          "enum": [
            "fact",
            "inference",
            "unknown"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceSource"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "fact",
                  "inference"
                ]
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "sources": {
                "minItems": 1
              }
            },
            "required": [
              "confidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "unknown"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "sources": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "status",
        "mode",
        "source"
      ],
      "properties": {
        "gate": {
          "type": "string",
          "enum": [
            "G3_TOPIC",
            "G4_MANUSCRIPT",
            "G5_PUBLISHING_ASSETS"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "review",
            "auto"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "confirmedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorizationRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "APPROVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "confirmedAt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "auto"
              },
              "status": {
                "const": "APPROVED"
              }
            },
            "required": [
              "mode",
              "status"
            ]
          },
          "then": {
            "required": [
              "authorizationRef"
            ]
          }
        }
      ]
    },
    "extensionCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "status",
        "interfaceVersion",
        "inputContractTypes",
        "outputContractType"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "enum": [
            "trend-scan",
            "single-work-analysis",
            "multi-work-analysis",
            "video-analysis",
            "book-analysis",
            "style-imitation",
            "channel-distillation",
            "content-deconstruction",
            "direct-rewrite",
            "synthesis-rewrite",
            "title-generation",
            "description-generation",
            "thumbnail-generation"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "unavailable",
            "planned-unavailable"
          ]
        },
        "interfaceVersion": {
          "$ref": "#/$defs/semver"
        },
        "inputContractTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "channel-profile",
              "production-profile",
              "source-package",
              "topic-package",
              "manuscript-package",
              "analysis-package-v1"
            ]
          }
        },
        "outputContractType": {
          "type": "string",
          "enum": [
            "analysis-package-v1",
            "writing-style-contract-v1",
            "reference-channel-profile-v1",
            "topic-package",
            "title-asset-v1",
            "description-asset-v1",
            "thumbnail-asset-v1"
          ]
        },
        "skillId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "skillVersion": {
          "$ref": "#/$defs/semver"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "skillId",
              "skillVersion"
            ]
          },
          "else": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "envelope": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractType",
        "id",
        "version",
        "createdAt",
        "hashAlgorithm",
        "hashRule",
        "contentHash",
        "upstream"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/semver"
        },
        "contractType": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "hashAlgorithm": {
          "const": "SHA-256"
        },
        "hashRule": {
          "const": "canonical-json-v1"
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "upstream": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contractReference"
          }
        }
      }
    }
  }
}

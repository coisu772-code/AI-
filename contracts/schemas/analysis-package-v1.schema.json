{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coisu772-code/AI-/contracts/schemas/analysis-package-v1.schema.json",
  "title": "Analysis Package v1",
  "allOf": [
    { "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/envelope" },
    {
      "if": {
        "properties": { "analysisKind": { "const": "channel-distillation" } },
        "required": ["analysisKind"]
      },
      "then": {
        "required": ["distillationId", "referenceProfiles", "fusionProfile"]
      },
      "else": {
        "if": {
          "properties": { "analysisKind": { "const": "content-deconstruction" } },
          "required": ["analysisKind"]
        },
        "then": {
          "required": ["deconstructionId", "distillationId", "sourceAnalyses", "failedSources", "comparison", "downstreamViews", "directionPackage"]
        },
        "else": {
          "required": ["deconstructionId", "distillationId", "videoAnalyses", "failedVideos", "comparison", "downstreamViews"]
        }
      }
    }
  ],
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "analysisKind", "targetChannelProfileId", "mode", "analysisBuckets", "qualityGate", "status"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractType": { "const": "analysis-package-v1" },
    "analysisKind": { "enum": ["channel-distillation", "video-copy-deconstruction", "content-deconstruction"] },
    "distillationId": { "type": ["string", "null"], "minLength": 3, "maxLength": 128 },
    "deconstructionId": { "type": "string", "minLength": 3, "maxLength": 128 },
    "targetChannelProfileId": { "type": "string", "minLength": 3, "maxLength": 160 },
    "mode": { "enum": ["single", "parallel", "compare", "fusion"] },
    "analysisBuckets": { "$ref": "#/$defs/buckets" },
    "referenceProfiles": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "object" } },
    "fusionProfile": { "type": ["object", "null"] },
    "videoAnalyses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/video-deconstruction-analysis-v1.schema.json" }
    },
    "failedVideos": { "type": "array", "maxItems": 8, "items": { "type": "object" } },
    "sourceAnalyses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/content-deconstruction-analysis-v1.schema.json" }
    },
    "failedSources": { "type": "array", "maxItems": 8, "items": { "type": "object" } },
    "comparison": { "type": ["object", "null"] },
    "directionPackage": { "$ref": "#/$defs/directionPackage" },
    "downstreamViews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topicCenter", "manuscriptCenter"],
      "properties": {
        "topicCenter": { "type": "object" },
        "manuscriptCenter": { "type": "object" },
        "rewrite": { "type": "object" },
        "productionText": { "type": "object" }
      }
    },
    "qualityGate": { "type": "object" },
    "status": { "const": "FROZEN" }
  },
  "$defs": {
    "directionPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentMode", "activeAdaptationModes", "activeVersionId", "contentLocks",
        "sourceStoryDNA", "audienceNeedModel", "expansionSeams", "adaptationProfiles", "directions",
        "directionDistinctnessMatrix", "selection"
      ],
      "properties": {
        "intentMode": {
          "enum": ["exploratory_recommendation", "scope_locked_migration", "delta_revision"]
        },
        "activeAdaptationModes": {
          "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
          "items": { "enum": ["close-structure", "balanced-reconstruction", "free-original"] }
        },
        "activeVersionId": { "type": "string", "minLength": 3, "maxLength": 128 },
        "contentLocks": { "type": "object", "minProperties": 4 },
        "scopeChangeContract": { "type": "object" },
        "deltaRevision": { "type": "object" },
        "scopeLockedCard": { "type": "object" },
        "intentQualityGate": { "type": "object" },
        "sourceStoryDNA": { "type": "object", "minProperties": 8 },
        "audienceNeedModel": { "type": "object", "minProperties": 3 },
        "expansionSeams": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "adaptationProfiles": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object" } },
        "directions": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "type": "object" } },
        "directionDistinctnessMatrix": { "type": "array", "minItems": 0, "maxItems": 105, "items": { "type": "object" } },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "selectedDirectionId"],
          "properties": {
            "status": { "const": "AWAITING_USER" },
            "selectedDirectionId": { "type": ["string", "null"] },
            "recommendedByTier": { "type": "object", "minProperties": 1, "maxProperties": 3 },
            "proposedDirectionId": { "type": ["string", "null"] }
          }
        }
      }
    },
    "buckets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originalFacts", "analysisConclusions", "transferableMethods", "prohibitedCopy", "unknowns"],
      "properties": {
        "originalFacts": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "analysisConclusions": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "transferableMethods": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "prohibitedCopy": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "unknowns": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      }
    }
  }
}

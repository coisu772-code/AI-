{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coisu772-code/AI-/contracts/schemas/manuscript-package.schema.json",
  "title": "Manuscript Package v1",
  "allOf": [
    {
      "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/envelope"
    },
    {
      "if": {
        "properties": {
          "targetLanguage": {
            "pattern": "^zh(?:-|$)"
          }
        },
        "required": [
          "targetLanguage"
        ]
      },
      "then": {
        "properties": {
          "auditScript": {
            "required": [
              "targetScriptReference"
            ],
            "not": {
              "anyOf": [
                { "required": ["asset"] },
                { "required": ["textAsset"] },
                { "required": ["lines"] }
              ]
            },
            "properties": {
              "mode": {
                "const": "same-as-target"
              },
              "duplicateFileCreated": {
                "const": false
              }
            }
          },
          "lineMapping": {
            "properties": {
              "mappingMode": {
                "const": "same-as-target"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "auditScript": {
            "required": [
              "asset",
              "textAsset",
              "lines"
            ],
            "not": {
              "required": [
                "targetScriptReference"
              ]
            },
            "properties": {
              "mode": {
                "const": "backtranslation"
              },
              "duplicateFileCreated": {
                "const": true
              }
            }
          },
          "lineMapping": {
            "properties": {
              "mappingMode": {
                "const": "backtranslation"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "SCRIPT_READY",
              "HANDED_TO_PUBLISHING_PREP"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "confirmation": {
            "properties": {
              "gate": {
                "const": "G4_MANUSCRIPT"
              },
              "status": {
                "const": "APPROVED"
              }
            }
          },
          "qualityGate": {
            "properties": {
              "status": {
                "const": "PASSED"
              }
            }
          },
          "lineMapping": {
            "properties": {
              "status": {
                "const": "PASSED"
              }
            }
          }
        }
      }
    }
  ],
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "manuscriptPackageId",
    "projectId",
    "channelProfileId",
    "status",
    "targetLanguage",
    "episodeCount",
    "lineCount",
    "storyBible",
    "characters",
    "voices",
    "targetScript",
    "auditScript",
    "lineMapping",
    "qualityGate",
    "qualityGateHash",
    "selectiveInvalidation",
    "confirmation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "contractType": {
      "const": "manuscript-package"
    },
    "id": { "type": "string", "minLength": 3, "maxLength": 128 },
    "version": { "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/semver" },
    "createdAt": { "type": "string", "format": "date-time" },
    "hashAlgorithm": { "const": "SHA-256" },
    "hashRule": { "const": "canonical-json-v1" },
    "contentHash": { "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256" },
    "upstream": {
      "type": "array",
      "items": { "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/contractReference" }
    },
    "manuscriptPackageId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "projectId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "channelProfileId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "status": {
      "type": "string",
      "enum": [
        "QUALITY_REVIEW",
        "BACKTRANSLATING",
        "AWAITING_JOINT_REVIEW",
        "SCRIPT_READY",
        "HANDED_TO_PUBLISHING_PREP",
        "NEEDS_REVISION",
        "PARTIAL"
      ]
    },
    "targetLanguage": {
      "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/bcp47Language"
    },
    "episodeCount": {
      "type": "integer",
      "minimum": 1
    },
    "lineCount": {
      "type": "integer",
      "minimum": 1
    },
    "soundEffects": {
      "$ref": "#/$defs/soundEffectsSelection"
    },
    "storyBible": {
      "$ref": "#/$defs/storyBible"
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "voices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/voiceBinding"
      }
    },
    "targetScript": {
      "$ref": "#/$defs/targetScript"
    },
    "auditScript": {
      "$ref": "#/$defs/auditScript"
    },
    "lineMapping": {
      "$ref": "#/$defs/lineMapping"
    },
    "qualityGate": {
      "$ref": "#/$defs/qualityGate"
    },
    "qualityGateHash": {
      "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
    },
    "foreignLanguageQualityGate": {
      "$ref": "#/$defs/foreignLanguageQualityGate"
    },
    "foreignLanguageQualityGateHash": {
      "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
    },
    "selectiveInvalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "invalidatedEpisodeNumbers",
        "upstreamStoryChangeRequiresNewTopicVersion"
      ],
      "properties": {
        "policy": {
          "const": "affected-episodes-only"
        },
        "invalidatedEpisodeNumbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "upstreamStoryChangeRequiresNewTopicVersion": {
          "const": true
        }
      }
    },
    "confirmation": {
      "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/approvalRecord"
    }
  },
  "$defs": {
    "soundEffectsSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "selectionSource",
        "confirmed"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "selectionSource": {
          "type": "string",
          "enum": [
            "user",
            "legacy_script_inference"
          ]
        },
        "confirmed": {
          "const": true
        }
      }
    },
    "storyBible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "contentHash",
        "sourceStoryFactsHash",
        "lockedFacts",
        "worldRules",
        "relationships",
        "timeline",
        "foreshadowing",
        "climax",
        "ending"
      ],
      "properties": {
        "version": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/semver"
        },
        "contentHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        },
        "sourceStoryFactsHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        },
        "lockedFacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "worldRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "relationships": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "foreshadowing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "climax": {
          "type": "string",
          "minLength": 1
        },
        "ending": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterId",
        "targetLanguageName",
        "role",
        "goal",
        "relationship",
        "speakingStyle",
        "visualConsistencyRequired"
      ],
      "properties": {
        "characterId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "personId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "appearanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lifePhase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ageStage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "referencePolicy": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "none"
          ]
        },
        "targetLanguageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        },
        "speakingStyle": {
          "type": "string",
          "minLength": 1
        },
        "visualConsistencyRequired": {
          "type": "boolean"
        },
        "visualAnchorPromptZh": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "visualConsistencyRequired": {
                "const": true
              }
            },
            "required": [
              "visualConsistencyRequired"
            ]
          },
          "then": {
            "required": [
              "visualAnchorPromptZh"
            ]
          }
        }
      ]
    },
    "voiceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speakerId",
        "engine",
        "voiceId",
        "voiceName",
        "bindingStatus",
        "catalogVersion",
        "catalogHash"
      ],
      "properties": {
        "speakerId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "voiceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "voiceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bindingStatus": {
          "const": "BOUND"
        },
        "catalogVersion": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/semver"
        },
        "catalogHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        }
      }
    },
    "scriptLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineId",
        "episodeNumber",
        "sequence",
        "speakerId",
        "lineType",
        "emotion",
        "text"
      ],
      "properties": {
        "lineId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "episodeNumber": {
          "type": "integer",
          "minimum": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "speakerId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "lineType": {
          "type": "string",
          "enum": [
            "narration",
            "dialogue",
            "sound_effect"
          ]
        },
        "emotion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "soundPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "audioEngine": {
          "const": "seed_audio"
        },
        "visualGenerationAllowed": {
          "const": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lineType": {
                "const": "sound_effect"
              }
            },
            "required": [
              "lineType"
            ]
          },
          "then": {
            "required": [
              "soundPrompt",
              "durationSeconds",
              "audioEngine",
              "visualGenerationAllowed"
            ],
            "properties": {
              "speakerId": {
                "const": "sfx"
              },
              "emotion": {
                "const": "sound_effect"
              },
              "text": {
                "pattern": "^【sound：.+；时长[0-9]+(?:\\.[0-9]+)?秒】$"
              }
            }
          }
        }
      ]
    },
    "targetScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "contentHash",
        "role",
        "isSoleProductionSource",
        "asset",
        "textAsset",
        "lines"
      ],
      "properties": {
        "version": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/semver"
        },
        "contentHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        },
        "role": {
          "const": "target-language-production-master"
        },
        "isSoleProductionSource": {
          "const": true
        },
        "asset": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/asset"
        },
        "textAsset": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/asset"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scriptLine"
          }
        }
      }
    },
    "auditScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "contentHash",
        "language",
        "mode",
        "sourceTargetScriptHash",
        "productionUseAllowed",
        "duplicateFileCreated"
      ],
      "properties": {
        "version": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/semver"
        },
        "contentHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        },
        "language": {
          "const": "zh-CN"
        },
        "mode": {
          "type": "string",
          "enum": [
            "backtranslation",
            "same-as-target"
          ]
        },
        "sourceTargetScriptHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        },
        "productionUseAllowed": {
          "const": false
        },
        "duplicateFileCreated": {
          "type": "boolean"
        },
        "targetScriptReference": {
          "const": "targetScript"
        },
        "asset": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/asset"
        },
        "textAsset": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/asset"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/scriptLine"
          }
        }
      }
    },
    "lineMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mappingMode",
        "targetLineCount",
        "auditLineCount",
        "checks",
        "items"
      ],
      "properties": {
        "status": {
          "const": "PASSED"
        },
        "mappingMode": {
          "type": "string",
          "enum": [
            "backtranslation",
            "same-as-target"
          ]
        },
        "targetLineCount": {
          "type": "integer",
          "minimum": 1
        },
        "auditLineCount": {
          "type": "integer",
          "minimum": 1
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lineIdsMatch",
            "episodeNumbersMatch",
            "sequenceMatches",
            "speakersMatch",
            "lineTypesMatch",
            "emotionsMatch"
          ],
          "properties": {
            "lineIdsMatch": {
              "const": true
            },
            "episodeNumbersMatch": {
              "const": true
            },
            "sequenceMatches": {
              "const": true
            },
            "speakersMatch": {
              "const": true
            },
            "lineTypesMatch": {
              "const": true
            },
            "emotionsMatch": {
              "const": true
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetLineId",
              "auditLineId",
              "episodeNumber",
              "sequence",
              "speakerId",
              "lineType",
              "emotion"
            ],
            "properties": {
              "targetLineId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128
              },
              "auditLineId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128
              },
              "episodeNumber": {
                "type": "integer",
                "minimum": 1
              },
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "speakerId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 128
              },
              "lineType": {
                "type": "string",
                "enum": [
                  "narration",
                  "dialogue",
                  "sound_effect"
                ]
              },
              "emotion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "qualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "contentHash",
        "targetScriptHash",
        "status",
        "revisionRounds",
        "episodeResults"
      ],
      "properties": {
        "version": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/semver"
        },
        "contentHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        },
        "targetScriptHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        },
        "status": {
          "const": "PASSED"
        },
        "revisionRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "episodeResults": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "episodeNumber",
              "status",
              "checks"
            ],
            "properties": {
              "episodeNumber": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "const": "PASSED"
              },
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "storyFacts",
                  "progressAndStateChange",
                  "characterVoice",
                  "targetLanguageNaturalness",
                  "regionalExpression",
                  "terminologyConsistency",
                  "ttsSemanticBoundaries",
                  "audienceRetelling"
                ],
                "properties": {
                  "storyFacts": {
                    "const": true
                  },
                  "progressAndStateChange": {
                    "const": true
                  },
                  "characterVoice": {
                    "const": true
                  },
                  "targetLanguageNaturalness": {
                    "const": true
                  },
                  "regionalExpression": {
                    "const": true
                  },
                  "terminologyConsistency": {
                    "const": true
                  },
                  "ttsSemanticBoundaries": {
                    "const": true
                  },
                  "audienceRetelling": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "foreignLanguageQualityGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "contentHash",
        "targetScriptHash",
        "targetLanguage",
        "status",
        "reviewMode",
        "independentFromAuthoring",
        "revisionRounds",
        "episodeResults",
        "summaryZh"
      ],
      "properties": {
        "version": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/semver"
        },
        "contentHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        },
        "targetScriptHash": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/sha256"
        },
        "targetLanguage": {
          "$ref": "https://github.com/coisu772-code/AI-/contracts/schemas/common.schema.json#/$defs/bcp47Language"
        },
        "status": {
          "enum": ["PASSED", "NOT_APPLICABLE"]
        },
        "reviewMode": {
          "enum": ["independent-second-pass", "not-applicable-target-is-chinese"]
        },
        "independentFromAuthoring": {
          "type": "boolean"
        },
        "authoringPassId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "reviewPassId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revisionRounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "episodeResults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["episodeNumber", "status", "revisionCount", "checks", "findingsZh"],
            "properties": {

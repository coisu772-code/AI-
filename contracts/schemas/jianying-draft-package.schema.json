{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coisu772-code/AI-/contracts/schemas/jianying-draft-package.schema.json",
  "title": "Jianying Draft Package v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageType", "projectId", "productionTaskId", "packageHash", "status", "files", "synthetic", "contentHash"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packageType": { "const": "jianying-draft-package-v1" },
    "projectId": { "type": "string", "minLength": 3 },
    "productionTaskId": { "type": "string", "minLength": 3 },
    "packageHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "const": "AWAITING_JIANYING_EXPORT" },
    "synthetic": { "type": "boolean" },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "files": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sizeBytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}

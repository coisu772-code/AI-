{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coisu772-code/AI-/contracts/schemas/publish-package-v2-validation.schema.json",
  "title": "YouTube Publish Package v2 Validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publish_intent_id", "valid", "validated_at", "constraints_catalog", "checks", "ffprobe", "source_technical_report_sha256"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "publish_intent_id": {"type": "string", "pattern": "^pi_[0-9a-f]{32}$"},
    "valid": {"const": true},
    "validated_at": {"type": "string", "format": "date-time"},
    "constraints_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "verified_at"],
      "properties": {
        "version": {"const": "2026.08.04.1"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "verified_at": {"type": "string", "format": "date"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "status"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "WARN", "FAIL"]},
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "ffprobe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "video_codec", "audio_codec", "pixel_format", "width", "height", "frame_rate", "duration_seconds"],
      "properties": {
        "container": {"type": "string", "minLength": 1},
        "video_codec": {"type": "string", "minLength": 1},
        "audio_codec": {"type": "string", "minLength": 1},
        "pixel_format": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frame_rate": {"type": "number", "exclusiveMinimum": 0},
        "duration_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "source_technical_report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

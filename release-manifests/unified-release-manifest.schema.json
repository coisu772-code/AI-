{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coisu772-code/AI-/release-manifests/unified-release-manifest.schema.json",
  "title": "AI Video Channel Production unified locked release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productId", "productName", "productVersion", "releaseStatus", "hashAlgorithm", "downloadBaseUrl", "generatedAt", "assets", "optionalRuntimePackages", "runtime", "logicalComponents", "safetyBoundaries", "publicationGates"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "productId": { "const": "ai-video-channel-production" },
    "productName": { "const": "AI 视频频道生产系统" },
    "productVersion": { "const": "0.10.0-rc.1" },
    "releaseStatus": { "const": "candidate" },
    "hashAlgorithm": { "const": "SHA-256" },
    "downloadBaseUrl": { "type": "string", "format": "uri" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "assets": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/asset" }
    },
    "optionalRuntimePackages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/optionalRuntimePackage" }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pythonVersion", "pythonBuild", "requiresPreinstalledPython", "requiresPreinstalledUv"],
      "properties": {
        "pythonVersion": { "const": "3.12.13" },
        "pythonBuild": { "const": "20260610" },
        "requiresPreinstalledPython": { "const": false },
        "requiresPreinstalledUv": { "const": false }
      }
    },
    "logicalComponents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/logicalComponent" } },
    "safetyBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialsIncluded", "userDataIncluded", "oauthExecuted", "realUploadExecuted", "longTermLearningWriteExecuted"],
      "properties": {
        "credentialsIncluded": { "const": false },
        "userDataIncluded": { "const": false },
        "oauthExecuted": { "const": false },
        "realUploadExecuted": { "const": false },
        "longTermLearningWriteExecuted": { "const": false }
      }
    },
    "publicationGates": { "type": "array", "minItems": 8, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "license": {
      "type": "object", "additionalProperties": false, "required": ["expression", "source", "reviewStatus"],
      "properties": { "expression": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 }, "reviewStatus": { "type": "string", "minLength": 1 } }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "fileName", "sizeBytes", "sha256", "version", "compatibleProductVersions", "install", "archiveRoot", "installSubpath", "license", "source"],
      "properties": {
        "assetId": { "enum": ["unified-installer", "core", "python-runtime", "workshop", "publisher-center"] },
        "fileName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]+[.]zip$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 },
        "compatibleProductVersions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "install": { "type": "boolean" },
        "archiveRoot": { "type": "string", "minLength": 1 },
        "installSubpath": { "type": "string" },
        "license": { "$ref": "#/$defs/license" },
        "source": { "type": "object", "minProperties": 1 }
      }
    },
    "fileRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^Z-Manga-Studio-kokoro-runtime-(cpu|nvidia|nvidia-blackwell)[.]zip[.]([0-9]{3})$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "optionalRuntimePackage": {
      "type": "object", "additionalProperties": false,
      "required": ["runtimeId", "runtimeVersion", "variant", "manifest", "archive", "parts", "license", "source"],
      "properties": {
        "runtimeId": { "const": "kokoro-fastapi" },
        "runtimeVersion": { "type": "string", "minLength": 1 },
        "variant": { "enum": ["cpu", "nvidia", "nvidia-blackwell"] },
        "manifest": {
          "type": "object", "additionalProperties": false,
          "required": ["fileName", "sizeBytes", "sha256"],
          "properties": {
            "fileName": { "type": "string", "pattern": "^Z-Manga-Studio-kokoro-runtime-(cpu|nvidia|nvidia-blackwell)[.]json$" },
            "sizeBytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "archive": {
          "type": "object", "additionalProperties": false,
          "required": ["fileName", "sha256"],
          "properties": {
            "fileName": { "type": "string", "pattern": "^Z-Manga-Studio-kokoro-runtime-(cpu|nvidia|nvidia-blackwell)[.]zip$" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileRecord" } },
        "license": { "$ref": "#/$defs/license" },
        "source": { "type": "object", "minProperties": 1 }
      }
    },
    "logicalComponent": {
      "type": "object", "additionalProperties": false,
      "required": ["componentId", "version", "providedByAsset", "license", "healthCheck", "files"],
      "properties": {
        "componentId": { "const": "ffmpeg-runtime" }, "version": { "const": "8.1.1" }, "providedByAsset": { "const": "workshop" },
        "license": { "type": "object", "required": ["expression", "source"] },
        "healthCheck": { "type": "object", "required": ["command", "expected"] },
        "files": { "type": "array", "minItems": 2, "items": { "type": "object", "required": ["relativeInstallPath", "sizeBytes", "sha256"], "properties": { "relativeInstallPath": { "type": "string" }, "sizeBytes": { "type": "integer" }, "sha256": { "$ref": "#/$defs/sha256" } } } }
      }
    }
  }
}
